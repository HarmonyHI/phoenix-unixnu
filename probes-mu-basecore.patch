diff --git a/ArmPkg/Drivers/CpuDxe/CpuMmuCommon.c b/ArmPkg/Drivers/CpuDxe/CpuMmuCommon.c
index addcf76..4cd2096 100644
--- a/ArmPkg/Drivers/CpuDxe/CpuMmuCommon.c
