# build output
out/
Build/
*.img
*.fd
*.efi
*.fat
*.adt
*.dtb
*.o
*.dylib
*.a
__pycache__/
*.pyc

# the device tree is a required *input* (not rebuildable from dts/), so it ships
!dtb/
!dtb/*.dtb

# one binary is shipped on purpose: the image that was verified on the device,
# so the bootable result can be reproduced without a toolchain
!prebuilt/
!prebuilt/*.img

# host noise
.DS_Store
