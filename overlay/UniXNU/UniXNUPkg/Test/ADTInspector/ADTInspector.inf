[Defines]
  INF_VERSION    = 0x00010019
  BASE_NAME      = ADTInspector
  FILE_GUID      = E77B3C41-89DF-424C-949B-6E7689072552
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 0.1
  ENTRY_POINT    = AdtInspectorEntry

[Sources]
  ADTInspector.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Guids]
  gEfiFileInfoGuid           ## CONSUMES

[Protocols]
  gEfiSimpleFileSystemProtocolGuid  ## CONSUMES
