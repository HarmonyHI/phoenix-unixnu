+/**
+  Launch an embedded UEFI application from the firmware volume.
+
+  This bypasses the boot-option / variable-store machinery entirely, which is
+  required on devices that have no persistent variable storage or no block
+  storage at all (e.g. while UFS is not functional).
+**/
+STATIC
+VOID
+LaunchEmbeddedPayload (
+  IN CONST EFI_GUID  *FileGuid,
+  IN CONST CHAR8     *Name
+  )
+{
+  EFI_STATUS  Status;
+  VOID        *Buffer = NULL;
+  UINTN       Size    = 0;
+  EFI_HANDLE  Handle  = NULL;
+
+  Status = GetSectionFromAnyFv ((EFI_GUID *)FileGuid, EFI_SECTION_PE32, 0, &Buffer, &Size);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "PHX: %a not found in FV (%r), skipping\n", Name, Status));
+    return;
+  }
+
+  DEBUG ((DEBUG_ERROR, "PHX: launching %a (size=0x%lx)\n", Name, (UINT64)Size));
+
+  Status = gBS->LoadImage (TRUE, gImageHandle, NULL, Buffer, Size, &Handle);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "PHX: LoadImage(%a) failed: %r\n", Name, Status));
+    return;
+  }
+
+  Status = gBS->StartImage (Handle, NULL, NULL);
+  DEBUG ((DEBUG_ERROR, "PHX: %a returned: %r\n", Name, Status));
+}
+
