+STATIC UINTN XPos = 0;
+STATIC UINTN YPos = 0;
+
+//
+// Embedded payload application GUID (UniXNUPkg/Application/UniXNU)
+//
+STATIC CONST EFI_GUID mShellFileGuid = {
+  0x9B665204, 0xA133, 0x47A2, { 0x93, 0x96, 0x9E, 0x2B, 0x37, 0x0A, 0x4E, 0x25 }
+};
+
+//
+// Mu-Silicium SEC entry-argument HOB (incoming x0 = FDT address)
+//
+STATIC CONST EFI_GUID mEntryArgHobGuid = {
+  0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
+};
+
+//
+// Report only whether the bootloader handed a device tree over. The payload no
+// longer depends on it: UniXNURamDiskDxe publishes the copy embedded in the
+// firmware volume. Scanning DRAM here used to hang the bus on the HYP/QTEE
+// windows (0x85700000-0x86000000, 0x86200000-0x98500000).
+//
+STATIC
+VOID
+DumpFdtDiagnostics (
+  VOID
+  )
+{
+  if (GetFirstGuidHob (&mEntryArgHobGuid) == NULL) {
+    DEBUG ((DEBUG_ERROR, "PHXFD: no entry argument HOB, payload comes from the FV\n"));
+  } else {
+    DEBUG ((DEBUG_ERROR, "PHXFD: entry argument HOB present\n"));
+  }
+}
