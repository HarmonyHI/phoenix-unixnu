 STATIC UINTN XPos = 0;
 STATIC UINTN YPos = 0;
 
+//
+// Embedded payload application GUID (UniXNUPkg/Application/UniXNU)
+//
+STATIC CONST EFI_GUID mShellFileGuid = {
+  0x9B665204, 0xA133, 0x47A2, { 0x93, 0x96, 0x9E, 0x2B, 0x37, 0x0A, 0x4E, 0x25 }
+};
+
+//
+// Mu-Silicium SEC entry-argument HOB (incoming x0 = FDT address)
+//
+STATIC CONST EFI_GUID mEntryArgHobGuid = {
+  0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
+};
+
+//
+// Dump the FDT handoff state so a single screen photo shows where the
+// bootloader's device tree and the initrd payload actually live.
+//
+STATIC
+VOID
+DumpFdtDiagnostics (
+  VOID
+  )
+{
+  EFI_HOB_GUID_TYPE  *Hob;
+  UINT64             Dtb;
+  CONST VOID         *Fdt;
+  INT32              Chosen;
+  CONST VOID         *StartProp;
+  CONST VOID         *EndProp;
+  INT32              Len;
+  UINT64             Start;
+  UINT64             End;
+  UINT64             Addr;
+  UINTN              Found;
+  UINT8              *P;
+
+  Hob = GetFirstGuidHob (&mEntryArgHobGuid);
+  if (Hob == NULL) {
+    DEBUG ((DEBUG_ERROR, "PHXFD: no entry argument HOB\n"));
+  } else {
+    Dtb = ReadUnaligned64 ((CONST UINT64 *)GET_GUID_HOB_DATA (Hob));
+    DEBUG ((DEBUG_ERROR, "PHXFD: x0 (dtb) = 0x%016lx\n", Dtb));
+
+    Fdt = (CONST VOID *)(UINTN)Dtb;
+    if ((Dtb != 0) && ((Dtb & 3) == 0) && (FdtCheckHeader (Fdt) == 0)) {
+      DEBUG ((DEBUG_ERROR, "PHXFD: dtb ok, %u bytes\n", (UINT32)FdtTotalSize (Fdt)));
+      Chosen = FdtPathOffset (Fdt, "/chosen");
+      DEBUG ((DEBUG_ERROR, "PHXFD: /chosen offset = %d\n", Chosen));
+      if (Chosen >= 0) {
+        StartProp = FdtGetProp (Fdt, Chosen, "linux,initrd-start", &Len);
+        EndProp   = FdtGetProp (Fdt, Chosen, "linux,initrd-end", &Len);
+        if ((StartProp == NULL) || (EndProp == NULL)) {
+          DEBUG ((DEBUG_ERROR, "PHXFD: NO initrd props in /chosen\n"));
+        } else {
+          Start = Fdt64ToCpu (ReadUnaligned64 (StartProp));
+          End   = Fdt64ToCpu (ReadUnaligned64 (EndProp));
+          DEBUG ((DEBUG_ERROR, "PHXFD: initrd 0x%lx - 0x%lx (len 0x%lx)\n", Start, End, End - Start));
+          if ((Start != 0) && (End > Start)) {
+            P = (UINT8 *)(UINTN)Start;
+            DEBUG ((DEBUG_ERROR, "PHXFD: initrd head %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+                    P[0], P[1], P[2], P[3], P[4], P[5], P[6], P[7], P[8], P[9], P[10]));
+          }
+        }
+      }
+    } else {
+      DEBUG ((DEBUG_ERROR, "PHXFD: x0 is NOT a valid device tree\n"));
+    }
+  }
+
+  //
+  // Scan DRAM for the FAT payload signature ("UNIXNU00" OEM name at offset 3
+  // of the boot sector) to locate where the bootloader actually placed the
+  // ramdisk. Only probe mapped DRAM ranges — the gaps between them
+  // (0x84920000-0x85700000 and 0x98500000-0x9C000000) are unmapped and a
+  // read there would raise a data abort.
+  //
+  STATIC CONST UINT64  ScanRanges[][2] = {
+    { 0x80000000, 0x80600000 },  // Kernel
+    { 0x80600000, 0x81320000 },  // DBI Dump
+    { 0x81320000, 0x84920000 },  // DXE Heap
+    { 0x85700000, 0x86000000 },  // HYP .. GPU PRR
+    { 0x86200000, 0x98500000 },  // QTEE .. PIL_REGION end
+    { 0x9C000000, 0x9F800000 },  // Display Reserved .. TGCM end
+  };
+
+  Found = 0;
+  for (UINTN Range = 0; Range < ARRAY_SIZE (ScanRanges); Range++) {
+    for (Addr = ScanRanges[Range][0]; (Addr + 512) < ScanRanges[Range][1]; Addr += 512) {
+      P = (UINT8 *)(UINTN)Addr;
+      if ((P[3] == 'U') && (P[4] == 'N') && (P[5] == 'I') && (P[6] == 'X') &&
+          (P[7] == 'N') && (P[8] == 'U') && (P[9] == '0') && (P[10] == '0'))
+      {
+        DEBUG ((DEBUG_ERROR, "PHXFD: UNIXNU00 FAT at 0x%016lx\n", Addr));
+        if (++Found >= 8) {
+          break;
+        }
+      }
+    }
+
+    if (Found >= 8) {
+      break;
+    }
+  }
+
+  if (Found == 0) {
+    DEBUG ((DEBUG_ERROR, "PHXFD: no UNIXNU00 signature found in DRAM scan\n"));
+  }
+
+  //
+  // Also peek at the address we asked the bootloader to use.
+  //
+  P = (UINT8 *)(UINTN)0x8AB00000;
+  DEBUG ((DEBUG_ERROR, "PHXFD: [0x8AB00000] = %02x %02x %02x %02x %02x %02x %02x %02x\n",
+          P[0], P[1], P[2], P[3], P[4], P[5], P[6], P[7]));
+
+  //
+  // Give the operator time to photograph the screen before the log scrolls on.
+  //
+  gBS->Stall (8000000);
+}
+
